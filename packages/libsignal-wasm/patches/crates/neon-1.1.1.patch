+    match status {
+        Err(err @ napi::Status::PendingException) => return Err(err),
+        status => status.unwrap(),
+    };
+
+    let buf = buf.assume_init();
+    let bytes = as_mut_slice(env, buf).as_mut_ptr();
+    Ok((buf, bytes))
+}
