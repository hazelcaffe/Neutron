+// emnapi initializes WebAssembly addons through this export.
+#[cfg(target_family = "wasm")]
+#[no_mangle]
+unsafe extern "C" fn napi_register_wasm_v1(env: *mut c_void, m: *mut c_void) -> *mut c_void {
