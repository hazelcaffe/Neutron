diff -ruN a/src/sys/wasm_memory.rs b/src/sys/wasm_memory.rs
--- a/src/sys/wasm_memory.rs	1969-12-31 19:00:00.000000000 -0500
+++ b/src/sys/wasm_memory.rs	2026-11-22 07:33:43.937745689 -0500
@@ -0,0 +1,88 @@
+//! WebAssembly (emnapi) memory synchronization.
+//!
+//! JavaScript buffers can't alias wasm linear memory, so emnapi gives Rust a
+//! copy of a JS buffer's bytes in linear memory. Reads are refreshed on every
+//! access; writes must be copied back with `emnapi_sync_memory`. Every Neon
+//! path that hands Rust a mutable view records the buffer here, and the
+//! recorded buffers are synchronized before control returns to JavaScript.
+//!
+//! Buffers are tracked per call depth, so a nested Rust → JS → Rust call only
+//! flushes the buffers it touched; outer buffers stay recorded until the outer
+//! call returns.
+
+use std::cell::{Cell, RefCell};
+
+use super::{
+    bindings as napi,
+    raw::{Env, Local},
+};
+
+#[link(wasm_import_module = "emnapi")]
+unsafe extern "C" {
+    fn emnapi_sync_memory(
+        env: Env,
+        js_to_wasm: bool,
+        value: *mut Local,
+        offset: usize,
+        length: usize,
+    ) -> napi::Status;
+}
+
+thread_local! {
+    static DEPTH: Cell<u32> = const { Cell::new(0) };
+    static DIRTY: RefCell<Vec<(u32, Local)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Records a buffer, typed array or `ArrayBuffer` that Rust may write.
+pub unsafe fn mark_dirty(value: Local) {
+    let depth = DEPTH.with(Cell::get);
+    DIRTY.with(|dirty| dirty.borrow_mut().push((depth, value)));
+}
+
+/// Runs `f` as one JS → Rust call and synchronizes the buffers it wrote.
+pub unsafe fn call<R>(env: Env, f: impl FnOnce() -> R) -> R {
+    let depth = DEPTH.with(|depth| {
+        depth.set(depth.get() + 1);
+        depth.get()
+    });
+    let result = f();
+    flush(env, depth);
+    DEPTH.with(|value| value.set(depth - 1));
+    result
+}
+
+/// Like [`call`], for code that can't easily be wrapped in a closure: one call
+/// level that flushes its buffers when dropped.
+pub struct Flush {
+    env: Env,
+    depth: u32,
+}
+
+impl Flush {
+    pub unsafe fn new(env: Env) -> Self {
+        let depth = DEPTH.with(|depth| {
+            depth.set(depth.get() + 1);
+            depth.get()
+        });
+        Flush { env, depth }
+    }
+}
+
+impl Drop for Flush {
+    fn drop(&mut self) {
+        unsafe { flush(self.env, self.depth) };
+        DEPTH.with(|value| value.set(self.depth - 1));
+    }
+}
+
+unsafe fn flush(env: Env, depth: u32) {
+    let pending: Vec<Local> = DIRTY.with(|dirty| {
+        let mut dirty = dirty.borrow_mut();
+        let split = dirty.iter().position(|(d, _)| *d >= depth).unwrap_or(dirty.len());
+        dirty.split_off(split).into_iter().map(|(_, value)| value).collect()
+    });
+    for mut value in pending {
+        // The whole buffer: emnapi treats u32::MAX (usize::MAX on wasm32) as "to the end".
+        let _ = unsafe { emnapi_sync_memory(env, false, &mut value, 0, usize::MAX) };
+    }
+}
