+pub unsafe fn uninitialized(env: Env, len: usize) -> Result<(Local, *mut u8), napi::Status> {
+    // A data pointer here would make emnapi return a view of the shared wasm
+    // memory, which browser APIs reject. Create an ordinary JS buffer instead.
+    let mut buf = MaybeUninit::uninit();
+    let status = napi::create_buffer(env, len, std::ptr::null_mut(), buf.as_mut_ptr());
