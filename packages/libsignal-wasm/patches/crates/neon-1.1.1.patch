+
+// A reactor module runs its static constructors once, here, rather than
+// around every exported call. Distributed slices register from them.
+#[cfg(target_family = "wasm")]
+#[no_mangle]
+extern "C" fn _initialize() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    unsafe extern "C" {
+        fn __wasm_call_ctors();
+        fn __wasi_init_tp();
+    }
+    // Memory is shared: constructors must run once, not once per thread instance.
+    static INITIALIZED: AtomicBool = AtomicBool::new(false);
+    if INITIALIZED.swap(true, Ordering::AcqRel) {
+        return;
+    }
+    unsafe {
+        // What wasi-libc's crt1-reactor `_initialize` does: set up the main
+        // thread's libc state (pthread self, thread list), then constructors.
+        __wasi_init_tp();
+        __wasm_call_ctors()
+    }
+}
