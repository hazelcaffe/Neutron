diff --git a/rust/net/infra/src/wasi_tcp.rs b/rust/net/infra/src/wasi_tcp.rs
new file mode 100644
index 0000000..d3a2dc3
--- /dev/null
+++ b/rust/net/infra/src/wasi_tcp.rs
@@ -0,0 +1,260 @@
+//
+// Copyright 2026 Neutron contributors.
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+//! TCP for `wasm32-wasip1-threads` builds hosted by an embedder (Neutron).
+//!
+//! WASI preview 1 has no outgoing sockets. The embedder owns each connection
+//! (raw TCP, e.g. over a Wisp relay) on a JavaScript thread that never blocks.
+//! Rust and the embedder share a [`Shared`] block per connection in linear
+//! memory: the embedder appends received bytes to its ring and wakes the
+//! reading task through [`neutron_tcp_wake`]. Connecting, sending and closing
+//! go through the `neutron` imports. TLS stays in this module's callers
+//! (BoringSSL), so certificate pinning is unchanged.
+//!
+//! The embedder side must not block, so everything it touches is lock-free:
+//! atomics in [`Shared`] and an [`AtomicWaker`].
+
+use std::cell::UnsafeCell;
+use std::io;
+use std::net::{IpAddr, Ipv4Addr, SocketAddr};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::task::{Context, Poll};
+
+use futures_util::task::AtomicWaker;
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+/// Receive ring capacity. The embedder keeps any excess queued until Rust
+/// reports progress through `neutron.tcp_consumed`.
+pub const RING_CAPACITY: u32 = 256 * 1024;
+
+const CONNECTING: u32 = 0;
+const OPEN: u32 = 1;
+const FAILED: u32 = 2;
+const EOF: u32 = 3;
+const RESET: u32 = 4;
+
+/// Shared with the embedder. Layout (byte offsets): `state` 0, `head` 4,
+/// `tail` 8, `sequence` 12, `ring` 16.
+#[repr(C, align(16))]
+pub struct Shared {
+    state: AtomicU32,
+    /// Total bytes the embedder has written to `ring` (wrapping).
+    head: AtomicU32,
+    /// Total bytes Rust has consumed from `ring` (wrapping).
+    tail: AtomicU32,
+    /// Owned by the embedder: numbers this connection's calls into it, which
+    /// can come from different threads, so it can apply them in order.
+    sequence: AtomicU32,
+    ring: UnsafeCell<[u8; RING_CAPACITY as usize]>,
+}
+
+// The ring is single-producer (embedder) single-consumer (Rust); ownership of
+// each region is transferred by the `head`/`tail` atomics.
+unsafe impl Sync for Shared {}
+
+/// `repr(C)` keeps `shared` at offset 0, so the embedder can use the
+/// documented [`Shared`] offsets relative to the pointer it is given.
+#[repr(C)]
+pub struct Inner {
+    shared: Shared,
+    waker: AtomicWaker,
+}
+
+#[link(wasm_import_module = "neutron")]
+unsafe extern "C" {
+    /// Opens a connection to `host:port`. `shared` is an `Inner` pointer; the
+    /// embedder passes it back to [`neutron_tcp_wake`] until it calls
+    /// [`neutron_tcp_release`] after `tcp_close`.
+    fn tcp_connect(shared: *const Inner, host: *const u8, host_len: usize, port: u16);
+    /// Sends bytes. The embedder copies them before returning.
+    fn tcp_write(shared: *const Inner, data: *const u8, len: usize);
+    /// Tells the embedder that ring space was freed.
+    fn tcp_consumed(shared: *const Inner);
+    /// Closes the connection. The embedder answers with `neutron_tcp_release`.
+    fn tcp_close(shared: *const Inner);
+}
+
+/// Called by the embedder (from any thread) after changing `state` or `head`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn neutron_tcp_wake(shared: *const Inner) {
+    unsafe { (*shared).waker.wake() };
+}
+
+/// Called once by the embedder after `tcp_close`, when it will no longer
+/// touch the connection. Releases the embedder's reference.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn neutron_tcp_release(shared: *const Inner) {
+    drop(unsafe { Arc::from_raw(shared) });
+}
+
+/// Byte offset of the ring in an `Inner`, so the embedder can verify the layout.
+#[unsafe(no_mangle)]
+pub extern "C" fn neutron_tcp_ring_offset() -> u32 {
+    (std::mem::offset_of!(Inner, shared) + std::mem::offset_of!(Shared, ring)) as u32
+}
+
+/// Ring capacity in bytes, for the embedder.
+#[unsafe(no_mangle)]
+pub extern "C" fn neutron_tcp_ring_capacity() -> u32 {
+    RING_CAPACITY
+}
+
+pub struct JsTcpStream {
+    inner: Arc<Inner>,
+    peer: SocketAddr,
+    closed: bool,
+}
+
+impl std::fmt::Debug for JsTcpStream {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("JsTcpStream").field("peer", &self.peer).finish()
+    }
+}
+
+impl JsTcpStream {
+    /// Connects through the embedder. `address` is what DNS resolved; the
+    /// embedder connects to that exact address.
+    pub async fn connect(address: IpAddr, port: u16) -> io::Result<Self> {
+        let inner = Arc::new(Inner {
+            shared: Shared {
+                state: AtomicU32::new(CONNECTING),
+                head: AtomicU32::new(0),
+                tail: AtomicU32::new(0),
+                sequence: AtomicU32::new(0),
+                ring: UnsafeCell::new([0; RING_CAPACITY as usize]),
+            },
+            waker: AtomicWaker::new(),
+        });
+        let host = address.to_string();
+        // One reference belongs to the embedder until neutron_tcp_release.
+        let embedder = Arc::into_raw(inner.clone());
+        unsafe { tcp_connect(embedder, host.as_ptr(), host.len(), port) };
+        let stream = JsTcpStream {
+            inner,
+            peer: SocketAddr::new(address, port),
+            closed: false,
+        };
+        std::future::poll_fn(|cx| {
+            stream.inner.waker.register(cx.waker());
+            match stream.inner.shared.state.load(Ordering::Acquire) {
+                CONNECTING => Poll::Pending,
+                FAILED => Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::ConnectionRefused,
+                    "connection failed",
+                ))),
+                _ => Poll::Ready(Ok(())),
+            }
+        })
+        .await?;
+        Ok(stream)
+    }
+
+    pub fn set_nodelay(&self, _nodelay: bool) -> io::Result<()> {
+        // The relay owns the real socket; Nagle is its concern.
+        Ok(())
+    }
+
+    pub fn local_addr(&self) -> io::Result<SocketAddr> {
+        // The browser has no local socket address to report.
+        let unspecified = match self.peer.ip() {
+            IpAddr::V4(_) => IpAddr::V4(Ipv4Addr::UNSPECIFIED),
+            IpAddr::V6(_) => IpAddr::V6(std::net::Ipv6Addr::UNSPECIFIED),
+        };
+        Ok(SocketAddr::new(unspecified, 0))
+    }
+
+    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
+        Ok(self.peer)
+    }
+
+    fn close(&mut self) {
+        if !self.closed {
+            self.closed = true;
+            unsafe { tcp_close(Arc::as_ptr(&self.inner)) };
+        }
+    }
+}
+
+impl Drop for JsTcpStream {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+impl AsyncRead for JsTcpStream {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let shared = &self.inner.shared;
+        self.inner.waker.register(cx.waker());
+        let head = shared.head.load(Ordering::Acquire);
+        let tail = shared.tail.load(Ordering::Relaxed);
+        let available = head.wrapping_sub(tail);
+        if available == 0 {
+            return match shared.state.load(Ordering::Acquire) {
+                EOF => Poll::Ready(Ok(())),
+                RESET | FAILED => Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::ConnectionReset,
+                    "connection reset",
+                ))),
+                _ => Poll::Pending,
+            };
+        }
+        let count = (available as usize).min(buf.remaining());
+        let start = (tail % RING_CAPACITY) as usize;
+        let first = count.min(RING_CAPACITY as usize - start);
+        let ring = unsafe { &*shared.ring.get() };
+        buf.put_slice(&ring[start..start + first]);
+        if first < count {
+            buf.put_slice(&ring[..count - first]);
+        }
+        shared
+            .tail
+            .store(tail.wrapping_add(count as u32), Ordering::Release);
+        unsafe { tcp_consumed(Arc::as_ptr(&self.inner)) };
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncWrite for JsTcpStream {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        data: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        match self.inner.shared.state.load(Ordering::Acquire) {
+            OPEN | EOF => {
+                unsafe { tcp_write(Arc::as_ptr(&self.inner), data.as_ptr(), data.len()) };
+                Poll::Ready(Ok(data.len()))
+            }
+            _ => Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "connection is not open",
+            ))),
+        }
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.close();
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl crate::Connection for JsTcpStream {
+    fn transport_info(&self) -> crate::TransportInfo {
+        crate::TransportInfo {
+            local_addr: self.local_addr().expect("always available"),
+            remote_addr: self.peer,
+        }
+    }
+}
