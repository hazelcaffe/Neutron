diff --git a/client/libcurl/request.c b/client/libcurl/request.c
index fc172fc..58c4472 100644
--- a/client/libcurl/request.c
+++ b/client/libcurl/request.c
@@ -59,6 +59,16 @@ CURL* create_request(const char* url, int request_id, DataCallback data_callback
   return http_handle;
 }
 
+//replace the default CA bundle for this request (PEM, one or more certificates)
+//certificate verification stays enabled; only the trusted roots change
+void request_set_cainfo(CURL* http_handle, const char* pem) {
+  struct curl_blob blob;
+  blob.data = (void*) pem;
+  blob.len = strlen(pem);
+  blob.flags = CURL_BLOB_COPY;
+  curl_easy_setopt(http_handle, CURLOPT_CAINFO_BLOB, &blob);
+}
+
 void request_cleanup(CURL* http_handle) {
   struct RequestInfo *request_info = get_request_info(http_handle);
   curl_easy_cleanup(http_handle);
